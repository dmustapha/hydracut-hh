# Public hostname served by Caddy — obtain from: deployment DNS configuration
APP_DOMAIN=hydracut.example.invalid

# ACME notices — obtain from: deployment operator
ACME_EMAIL=operator@example.invalid

# Browser runner origin inside its isolated container — obtain from: fixed Compose topology
BASE_URL=http://127.0.0.1:3000

# Structured log threshold — obtain from: deployment operator
LOG_LEVEL=info

# External evidence freshness window in seconds — obtain from: Architecture policy
SOURCE_CACHE_TTL_SECONDS=3600

# Compose-internal PostgreSQL secret path — obtain from: generated at deploy
DATABASE_URL_FILE=/run/secrets/database_url

# Compose-internal PostgreSQL password path — obtain from: generated at deploy
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Private self-hosted HydraDB HTTP origin — obtain from: fixed Compose service DNS
HYDRADB_HTTP_URL=http://hydradb:8443

# P0 graph namespace — obtain from: fixed deployment configuration
HYDRADB_GRAPH_NAMESPACE=default

# Compose-internal HydraDB token path — obtain from: generated at deploy
HYDRADB_TOKEN_FILE=/run/secrets/hydradb_token

# Fine-grained read-only GitHub token path — obtain from: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN_FILE=/run/secrets/github_token

# Caddy process variable populated from its Docker secret at startup — obtain from: generated at deploy
APP_OPERATOR_TOKEN=placeholder_generated_operator_token

# Secret files are created outside Git and mounted by docker-compose.yml:
# secrets/postgres_password  — generate a high-entropy database password
# secrets/database_url       — postgres://hydracut:<percent-encoded-password>@postgres:5432/hydracut
# secrets/hydradb_token      — generate 32 random bytes and encode for HydraDB
# secrets/github_token       — fine-grained public-repository Contents/Metadata/Pull Requests read token
# secrets/app_operator_token — generate a high-entropy single-operator bearer token
